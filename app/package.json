{
  "name": "openwraith-desktop",
  "private": true,
  "version": "0.2.0",
  "description": "OpenWraith desktop app frontend (not affiliated with Wraith).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tauri dev --features sim --config src-tauri/tauri.sim.conf.json",
    "dev:hid": "tauri dev",
    "dev:web": "vite --port 1420 --strictPort",
    "dev:preview": "vite --mode mock --port 1421 --strictPort",
    "preview:mock": "vite --mode mock --port 1421 --strictPort",
    "preview:prod": "vite preview --mode production --port 1422 --strictPort",
    "build": "npm run build:web",
    "build:web": "npm run typecheck && vite build && node scripts/third-party-notices.mjs && node scripts/check-dist.mjs",
    "build:notices": "node scripts/third-party-notices.mjs",
    "build:check": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.12.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}

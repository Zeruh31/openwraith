{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window may call the app's commands and nothing else: no core or plugin permissions (dialogs and the file manager are used from Rust only).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-get-settings",
    "allow-set-settings",
    "allow-subscribe",
    "allow-get-status",
    "allow-get-snapshot",
    "allow-get-last-report",
    "allow-cancel-operation",
    "allow-answer-close",
    "allow-dismiss-interrupted",
    "allow-list-safety-backups",
    "allow-open-safety-backup",
    "allow-open-backup-file",
    "allow-choose-backup-destination",
    "allow-reveal",
    "allow-refresh",
    "allow-select-device",
    "allow-reconnect",
    "allow-disconnect",
    "allow-recheck-other-program",
    "allow-prepare-profile-switch",
    "allow-apply-profile-switch",
    "allow-prepare-trigger-edit",
    "allow-apply-trigger-edit",
    "allow-prepare-light-edit",
    "allow-apply-light-edit",
    "allow-backup-active-profile",
    "allow-prepare-all-profile-backup",
    "allow-apply-all-profile-backup",
    "allow-prepare-restore",
    "allow-apply-restore",
    "allow-discard-plan",
    "allow-get-keys-state",
    "allow-prepare-keymap-edit",
    "allow-apply-keymap-edit",
    "allow-list-macro-library",
    "allow-save-library-macro",
    "allow-rename-library-macro",
    "allow-delete-library-macro",
    "allow-get-colors-state",
    "allow-prepare-color-edit",
    "allow-apply-color-edit",
    "allow-get-dead-band-state",
    "allow-prepare-dead-band-edit",
    "allow-apply-dead-band-edit",
    "allow-get-socd-state",
    "allow-prepare-socd-edit",
    "allow-apply-socd-edit",
    "allow-list-presets",
    "allow-save-user-preset",
    "allow-delete-user-preset",
    "allow-prepare-preset-edit",
    "allow-start-depth-view",
    "allow-stop-depth-view",
    "allow-close-stray-travel-test",
    "allow-choose-export-destination",
    "allow-export-profile",
    "allow-open-import-file",
    "allow-prepare-import",
    "allow-apply-import",
    "allow-get-hints-shown",
    "allow-mark-hint-shown",
    "allow-reset-hints-shown"
  ]
}
